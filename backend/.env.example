# Server Port (Render automatically supplies process.env.PORT)
PORT=5000

# MongoDB Connection String
# For Local Development:
MONGO_URI=mongodb://127.0.0.1:27017/flipshop

# For Production (Render / Cloud Hosting) - Replace with your MongoDB Atlas Connection String:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/flipshop?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=mysecretkey

# Frontend URL (For Production CORS)
# FRONTEND_URL=https://your-frontend-domain.onrender.com
